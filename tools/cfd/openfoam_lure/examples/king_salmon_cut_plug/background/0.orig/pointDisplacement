FoamFile
{
    version     2.0;
    format      ascii;
    class       pointVectorField;
    object      pointDisplacement;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Pattern from ESI v2412 multiphase/overInterDyMFoam/floatingBody.

dimensions      [0 1 0 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    // Overset patches (background dummy + component outer boundary)
    oversetPatch
    {
        patchType       overset;
        type            zeroGradient;
    }

    lureOverset
    {
        patchType       overset;
        type            zeroGradient;
    }

    // Moving body: displacement computed by the 6-DoF motion solver
    lure
    {
        type            calculated;
        value           uniform (0 0 0);
    }

    // Fixed background boundaries
    inlet
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }

    outlet
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }

    farfield
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
}


