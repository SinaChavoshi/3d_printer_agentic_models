FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Box refinement of the background mesh only (no surfaces, no snapping).
// Same technique as ESI v2412
// tutorials/incompressible/overSimpleFoam/aeroFoil/background_snappyHexMesh.
// The innermost box covers the lure's expected motion envelope so that the
// background cell size there matches the component mesh's outer cells.

castellatedMesh true;
snap            false;
addLayers       false;


geometry
{
    wakeBox         // level 1: long wake region
    {
        type    box;
        min     (-0.202631846 -0.358561917 -0.412551554);
        max     (0.818016357 0.358560105 0.413860003);
    }

    nearBox         // level 2
    {
        type    box;
        min     (-0.143731326 -0.299661397 -0.353651034);
        max     (0.464613237 0.299659585 0.354959483);
    }

    motionBox       // level 3: motion envelope of the overset component
    {
        type    box;
        min     (-0.0848308062 -0.240760877 -0.294750514);
        max     (0.229011157 0.240759065 0.296058963);
    }
}


castellatedMeshControls
{
    maxLocalCells       2000000;
    maxGlobalCells      20000000;
    minRefinementCells  10;
    maxLoadUnbalance    0.10;
    nCellsBetweenLevels 4;

    features
    (
    );

    refinementSurfaces
    {
    }

    resolveFeatureAngle 30;

    refinementRegions
    {
        wakeBox
        {
            mode inside;
            levels ((1e15 1));
        }
        nearBox
        {
            mode inside;
            levels ((1e15 2));
        }
        motionBox
        {
            mode inside;
            levels ((1e15 3));
        }
    }

    locationInMesh (-0.338874325 -0.474738192 -0.532853372);

    allowFreeStandingZoneFaces true;
}


snapControls
{
    nSmoothPatch    3;
    tolerance       4.0;
    nSolveIter      30;
    nRelaxIter      5;
}


addLayersControls
{
    relativeSizes       true;
    layers
    {
    }
    expansionRatio      1.3;
    finalLayerThickness 0.7;
    minThickness        0.25;
    nGrow               0;
    featureAngle        60;
    nRelaxIter          5;
    nSmoothSurfaceNormals 1;
    nSmoothNormals      3;
    nSmoothThickness    10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle  90;
    nBufferCellsNoExtrude 0;
    nLayerIter          50;
}


meshQualityControls
{
    maxNonOrtho         65;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave          80;
    minVol              1e-18;
    minTetQuality       1e-30;
    minArea             -1;
    minTwist            0.05;
    minDeterminant      0.001;
    minFaceWeight       0.05;
    minVolRatio         0.01;
    minTriangleTwist    -1;

    nSmoothScale        4;
    errorReduction      0.75;
}

writeFlags
(
);

mergeTolerance 1e-6;


