FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Background (water tunnel) mesh. Flow is in +x; the lure is towed towards -x.
// Patch layout follows ESI v2412 multiphase/overInterDyMFoam/floatingBody:
// an empty overset patch comes first so that overset interpolation is
// triggered before any other boundary condition is evaluated.

scale   1;

vertices
(
    (@@B_XMIN@@ @@B_YMIN@@ @@B_ZMIN@@)
    (@@B_XMAX@@ @@B_YMIN@@ @@B_ZMIN@@)
    (@@B_XMAX@@ @@B_YMAX@@ @@B_ZMIN@@)
    (@@B_XMIN@@ @@B_YMAX@@ @@B_ZMIN@@)
    (@@B_XMIN@@ @@B_YMIN@@ @@B_ZMAX@@)
    (@@B_XMAX@@ @@B_YMIN@@ @@B_ZMAX@@)
    (@@B_XMAX@@ @@B_YMAX@@ @@B_ZMAX@@)
    (@@B_XMIN@@ @@B_YMAX@@ @@B_ZMAX@@)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (@@B_NX@@ @@B_NY@@ @@B_NZ@@) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    // Dummy patch to trigger overset interpolation before any other bcs
    oversetPatch
    {
        type overset;
        faces ();
    }

    inlet
    {
        type patch;
        faces
        (
            (0 4 7 3)
        );
    }

    outlet
    {
        type patch;
        faces
        (
            (2 6 5 1)
        );
    }

    // Lateral and vertical far-field boundaries
    farfield
    {
        type patch;
        faces
        (
            (1 5 4 0)
            (3 7 6 2)
            (0 3 2 1)
            (4 5 6 7)
        );
    }
);

mergePatchPairs
(
);


