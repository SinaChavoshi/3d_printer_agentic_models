FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Box refinement of the background mesh only (no surfaces, no snapping).
// Same technique as ESI v2412
// tutorials/incompressible/overSimpleFoam/aeroFoil/background_snappyHexMesh.
// The innermost box covers the lure's expected motion envelope so that the
// background cell size there matches the component mesh's outer cells.

castellatedMesh true;
snap            false;
addLayers       false;


geometry
{
    wakeBox         // level 1: long wake region
    {
        type    box;
        min     (@@R1_MIN@@);
        max     (@@R1_MAX@@);
    }

    nearBox         // level 2
    {
        type    box;
        min     (@@R2_MIN@@);
        max     (@@R2_MAX@@);
    }

    motionBox       // level 3: motion envelope of the overset component
    {
        type    box;
        min     (@@R3_MIN@@);
        max     (@@R3_MAX@@);
    }
}


castellatedMeshControls
{
    maxLocalCells       2000000;
    maxGlobalCells      @@MAX_GLOBAL_CELLS@@;
    minRefinementCells  10;
    maxLoadUnbalance    0.10;
    nCellsBetweenLevels 4;

    features
    (
    );

    refinementSurfaces
    {
    }

    resolveFeatureAngle 30;

    refinementRegions
    {
        wakeBox
        {
            mode inside;
            levels ((1e15 1));
        }
        nearBox
        {
            mode inside;
            levels ((1e15 2));
        }
        motionBox
        {
            mode inside;
            levels ((1e15 3));
        }
    }

    locationInMesh (@@BG_LOCATION@@);

    allowFreeStandingZoneFaces true;
}


snapControls
{
    nSmoothPatch    3;
    tolerance       4.0;
    nSolveIter      30;
    nRelaxIter      5;
}


addLayersControls
{
    relativeSizes       true;
    layers
    {
    }
    expansionRatio      1.3;
    finalLayerThickness 0.7;
    minThickness        0.25;
    nGrow               0;
    featureAngle        60;
    nRelaxIter          5;
    nSmoothSurfaceNormals 1;
    nSmoothNormals      3;
    nSmoothThickness    10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle  90;
    nBufferCellsNoExtrude 0;
    nLayerIter          50;
}


meshQualityControls
{
    maxNonOrtho         65;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave          80;
    minVol              1e-18;
    minTetQuality       1e-30;
    minArea             -1;
    minTwist            0.05;
    minDeterminant      0.001;
    minFaceWeight       0.05;
    minVolRatio         0.01;
    minTriangleTwist    -1;

    nSmoothScale        4;
    errorReduction      0.75;
}

writeFlags
(
);

mergeTolerance 1e-6;


