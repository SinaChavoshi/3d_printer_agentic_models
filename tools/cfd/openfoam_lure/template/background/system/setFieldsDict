FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// zoneID: 0 = background mesh, 1 = lure component mesh
// (as in ESI v2412 overPimpleDyMFoam/cylinder and overInterDyMFoam/floatingBody)

defaultFieldValues
(
    volScalarFieldValue zoneID 123
);

regions
(
    cellToCell
    {
        set c0;

        fieldValues
        (
            volScalarFieldValue zoneID 0
        );
    }

    cellToCell
    {
        set c1;

        fieldValues
        (
            volScalarFieldValue zoneID 1
        );
    }
);


