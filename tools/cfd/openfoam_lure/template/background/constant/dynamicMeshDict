FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      dynamicMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Free 6-DoF motion of the lure on an overset mesh.
// Keywords verified against ESI v2412 sources (sixDoFRigidBodyMotion,
// sixDoFRigidBodyMotionSolver, restraints/linearSpring) and the tutorial
// multiphase/overInterDyMFoam/floatingBody/background/constant/dynamicMeshDict.

dynamicFvMesh       dynamicOversetFvMesh;

motionSolverLibs    (sixDoFRigidBodyMotion);

solver              sixDoFRigidBodyMotion;

sixDoFRigidBodyMotionCoeffs
{
    patches         (lure);

    // Large distances => every point of the (connected) component mesh moves
    // rigidly with the body. The disconnected background mesh is never
    // reached by the point-distance wave and therefore stays fixed.
    innerDistance   100.0;
    outerDistance   101.0;

    // ---- Mass properties (printed part + ballast), SI units ---------------
    // centreOfMass is also the centre of rotation (no 'centreOfRotation').
    centreOfMass    (@@COM@@);
    mass            @@MASS@@;

    // Principal moments of inertia about the centre of mass (body frame) ...
    momentOfInertia (@@INERTIA@@);

    // ... and the principal axes as the columns of the initial orientation
    // tensor (body -> global), written row-major (xx xy xz yx yy yz zx zy zz).
    orientation     (@@ORIENTATION@@);

    // Fluid density: p is kinematic in overPimpleDyMFoam
    rho             rhoInf;
    rhoInf          @@RHO@@;

    // overPimpleDyMFoam does not read constant/g, so gravity is given to the
    // motion solver here (it is applied as mass*g at the centre of mass).
    // Buoyancy is NOT part of the fluid force (no hydrostatic pressure in a
    // single-phase incompressible solver): see the 'buoyancy' restraint.
    g               (@@GRAVITY@@);

    report          on;     // per-step state in the log (parsed by postprocess.py)

    // Explicit (once-per-time-step) fluid/body coupling: relax accelerations
    // to suppress the added-mass instability of light, neutrally-buoyant
    // bodies. accelerationDamping < 1 acts like extra inertia; keep 1 unless
    // the run diverges. Values chosen by prepare_case.py (see README).
    accelerationRelaxation  @@ACCEL_RELAX@@;
    accelerationDamping     @@ACCEL_DAMP@@;

    solver
    {
        type    Newmark;
    }

    restraints
    {
        // Leader (tow line) modelled as a linear spring-damper between a fixed
        // anchor (boat-side end of the leader) and the tow eye on the lure.
        // NOTE: a spring also pushes when compressed; a real line is
        // tension-only. With positive drag the line stays taut (see README).
        leader
        {
            sixDoFRigidBodyMotionRestraint linearSpring;
            anchor          (@@ANCHOR@@);
            refAttachmentPt (@@ATTACH@@);
            stiffness       @@K_LEADER@@;
            damping         @@C_LEADER@@;
            restLength      @@LEADER_LENGTH@@;
        }
//@@BUOYANCY_BEGIN@@
        // Buoyancy = rho*V*g acting at the centre of buoyancy, implemented as
        // a very long, very soft vertical spring (constant force to within
        // ~1e-5 relative error), so the hydrostatic righting moment from the
        // centre-of-buoyancy / centre-of-mass offset is captured.
        buoyancy
        {
            sixDoFRigidBodyMotionRestraint linearSpring;
            anchor          (@@BUOY_ANCHOR@@);
            refAttachmentPt (@@BUOY_ATTACH@@);
            stiffness       @@K_BUOY@@;
            damping         0;
            restLength      0;
        }
//@@BUOYANCY_END@@
    }

    // No constraints: all six degrees of freedom are free.
}


