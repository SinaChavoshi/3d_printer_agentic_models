# =====================================================================
# 3D Printer Agentic Studio - Environment Configuration
# Copy to .env and uncomment what you need. Never commit your .env.
# =====================================================================

# --- Google Gemini (default provider) --------------------------------
# Either an API key...
# GEMINI_API_KEY=your_gemini_api_key_here
# ...or Vertex AI via Application Default Credentials:
# GOOGLE_CLOUD_PROJECT=your_gcp_project_id
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Other providers (each key is only sent to its own provider) -----
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=

# --- Self-hosted OpenAI-compatible server (Ollama, vLLM, LM Studio) --
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# Extra endpoints users may select in the UI's "Custom Base URL" field:
# LLM_ALLOWED_BASE_URLS=http://gpu-box.local:8000/v1

# --- Access control (set this if anyone else can reach the server) ---
# STUDIO_ACCESS_TOKEN=choose-a-long-random-string
# CORS_ALLOW_ORIGINS=

# --- Sandbox limits for generated CAD code ----------------------------
# CAD_EXEC_TIMEOUT_SECONDS=60
# CAD_EXEC_MEMORY_MB=4096
